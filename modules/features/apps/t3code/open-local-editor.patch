+/**
+ * Builds a `<scheme>://file<path>` deep link that opens `absolutePath` on this
+ * machine in the local editor (VS Code and its forks, Zed). Returns undefined
+ * for editors without one (JetBrains IDEs).
+ */
+export const buildLocalOpenUrl = (input: {
+  readonly editor: EditorId;
+  readonly absolutePath: string;
+}): string | undefined => {
+  const scheme = remoteSchemeForEditor(input.editor);
+  if (scheme === undefined || scheme === "jetbrains") {
+    return undefined;
+  }
+  const posixPath = input.absolutePath.replaceAll("\\", "/");
+  const rootedPath = posixPath.startsWith("/") ? posixPath : `/${posixPath}`;
+  return `${scheme}://file${rootedPath.split("/").map(encodeURIComponent).join("/")}`;
+};
