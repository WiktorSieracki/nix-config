# A KVM cloud VPS (Hetzner Cloud CX x86, OVH VPS, …). Not generated by
# `nixos-generate-config`: the hardware is the same virtio machine on every
# such provider, and the disk layout comes from ./disko.nix.
{
  flake.modules.nixos."hosts/vpsNixos" = {
    lib,
    modulesPath,
    ...
  }: {
    imports = [(modulesPath + "/profiles/qemu-guest.nix")];

    boot.initrd.availableKernelModules = ["ahci" "xhci_pci" "virtio_pci" "virtio_scsi" "sd_mod" "sr_mod"];

    # The core floor installs GRUB for a laptop/desktop: EFI-only (`nodev`),
    # writing EFI variables, probing for other OSes. Cloud VPSes usually boot
    # legacy BIOS (Hetzner Cloud x86 does) and have no writable efivars, so GRUB
    # goes into the MBR via the BIOS boot partition in ./disko.nix *and* into
    # the ESP as the removable fallback — the same disk boots either way.
    boot.loader = {
      efi.canTouchEfiVariables = lib.mkForce false;
      timeout = lib.mkForce 3;
      grub = {
        devices = lib.mkForce ["/dev/sda"];
        efiInstallAsRemovable = true;
        useOSProber = lib.mkForce false;
      };
    };

    # Laptop-only services the core floor turns on; there is no such hardware here.
    hardware.bluetooth.enable = lib.mkForce false;
    services.power-profiles-daemon.enable = lib.mkForce false;

    # The always-on HM floor turns on gtk (desktop/cursor.nix), so home-manager
    # runs a dconfSettings step, which dies without a dconf service and takes
    # home-manager-wiktor.service — and with it the t3code units — down. No
    # session here for those settings to affect; same fix as the iso host.
    home-manager.users.wiktor.dconf.enable = false;
  };
}
